# Supabase конфигурация
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (новый стандарт Supabase pk_... или sb_publishable_...)
# Также поддерживается прежний NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Секретный ключ для сервера (Secret Key sk_... или Service Role Key)
SUPABASE_SECRET_KEY=your-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Настройки компании по умолчанию
NEXT_PUBLIC_DEFAULT_CURRENCY=KZT
NEXT_PUBLIC_TIMEZONE=Asia/Almaty
